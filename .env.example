# =============================================================================
# ANN & ASSOCIATES LAW FIRM & ACADEMY — CLOUD ENGINE CONFIGURATION
# Store live secrets in the firm's cloud Secret Manager (never commit .env)
# =============================================================================

# --- Runtime & Security ---
APP_ENV=production
TIMEZONE=Asia/Phnom_Penh
PORT=8080
WEBHOOK_SHARED_SECRET=replace_with_strong_random_secret_32chars
DASHBOARD_ACCESS_TOKEN=replace_with_dashboard_token

# --- Shared Managed Cloud PostgreSQL (Google Cloud SQL / Azure / Supabase / Neon) ---
# Production example:
# DATABASE_URL=postgresql://ann_user:STRONG_PASSWORD@your-cloud-db-host:5432/ann_firm_db?sslmode=require
# Local quick-test fallback:
DATABASE_URL=sqlite:///./data/ann_firm_local.db

# --- Telegram Bot (Owned by Ann & Associates Firm Account) ---
TELEGRAM_BOT_TOKEN=replace_with_firm_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_telegram_secret_token
PUBLIC_BASE_URL=https://ann-cloud-engine.example.com

# --- Firm Cloud Drive (Google Drive Service Account JSON, Base64-encoded) ---
GOOGLE_DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_DRIVE_BRONZE_FOLDER_ID=
GOOGLE_DRIVE_VAULT_FOLDER_ID=
